# Frugal — configuration shape.
#
# Copy to .env and fill in. Settings validate at import time, so the process
# fails fast on a missing or malformed value rather than surfacing it later as a
# confusing runtime error. This file documents structure only — never secrets.

# --- environment -------------------------------------------------------------
ENVIRONMENT=local              # local | ci | production
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console locally, json in production (Log Analytics)

# --- database ----------------------------------------------------------------
# Application connection. On Neon, use the POOLED endpoint.
DATABASE_URL=postgresql+asyncpg://frugal:frugal@localhost:5432/frugal
# Alembic only. On Neon, use the DIRECT (non-pooled) endpoint — DDL through a
# connection pooler is unreliable. Omit locally; it falls back to DATABASE_URL.
# DATABASE_DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/frugal
# Raised from 5+5 in M8: the advisor fans out to health, forecast and
# analytics concurrently, each on its own session, so one request can hold
# four connections. Matches the default in app/core/config.py.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- redis -------------------------------------------------------------------
# Celery broker, aggregate cache, and rate-limit counters. Holds only
# regenerable state — losing it degrades performance, never data.
REDIS_URL=redis://localhost:6379/0

# --- security ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900   # 15 min; held in memory, never localStorage
REFRESH_TOKEN_TTL_DAYS=30      # httpOnly cookie, rotated with reuse detection
CORS_ORIGINS=http://localhost:3000

# --- adapters (ADR-004) ------------------------------------------------------
STORAGE_BACKEND=minio          # s3 | minio | azure_blob | memory
OCR_ENGINE=fake                # tesseract | fake
PRICE_PROVIDER=simulated_market  # seed_catalog | simulated_market | manual
                                 # Advisor and market must share one provider,
                                 # or they quote different prices for one product.

# --- object storage ----------------------------------------------------------
# Two adapters behind one port (ADR-004, ADR-010):
#
#   STORAGE_BACKEND=s3          any S3-compatible endpoint — AWS S3, Cloudflare
#                               R2, Backblaze B2, MinIO. They differ only by
#                               endpoint, so one adapter covers all four.
#   STORAGE_BACKEND=azure_blob  Azure Blob Storage. A separate adapter because
#                               Azure is not S3-compatible: different auth,
#                               different signing, and an upload header the
#                               browser must send.
#
# Production runs `azure_blob`. Local development runs MinIO, below, because it
# needs no account and no network.
S3_BUCKET=frugal-receipts
S3_REGION=ap-south-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PRESIGNED_URL_TTL_SECONDS=300

# --- azure blob (production) -------------------------------------------------
# Read only when STORAGE_BACKEND=azure_blob.
#
# AZURE_STORAGE_ACCOUNT=frugalab12cd34   # terraform output storage_account
# AZURE_BLOB_CONTAINER=receipts
#
# Note what is absent: no credential. On the VM the adapter authenticates as
# the machine's system-assigned managed identity over IMDS and signs its SAS
# URLs with a 24-hour user delegation key, so there is no durable secret on the
# host to leak (NFR-2). The storage account has shared access keys disabled
# outright, so there is not even a key to set here by mistake.
#
# AZURE_STORAGE_KEY exists as a local-development escape hatch for Azurite and
# should never be set in production — an account key is full control over the
# whole storage account, which is strictly worse than the AWS access key this
# migration was partly meant to eliminate.

# --- engine thresholds -------------------------------------------------------
OCR_CONFIDENCE_THRESHOLD=0.75          # below this, a field goes to review
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.30  # below this, "uncategorised", not a guess.
                                          # Calibrated in tests/eval/, not chosen by feel:
                                          # 23 classes spread softmax mass thin, so a correct
                                          # top class often sits near 0.35.
FORECAST_MIN_OBSERVATION_DAYS=14       # below this the API returns 503, not a fabricated series
FORECAST_EWMA_MIN_DAYS=60              # tier 2 boundary
FORECAST_PROPHET_MIN_DAYS=180          # tier 3 boundary (~2 seasonal cycles)

# --- SMS ingestion (M12) -----------------------------------------------------
SMS_CONFIDENCE_THRESHOLD=0.75          # below this, a message goes to review rather
                                       # than into the ledger. At the OCR threshold, not
                                       # the categoriser's 0.30, because the trade is the
                                       # opposite one: a wrong category costs a click,
                                       # a wrong transaction is money in the ledger the
                                       # user has no reason to go looking for.
SMS_RAW_BODY_RETENTION_DAYS=30         # after this, only the redacted body remains.
                                       # A committed or dismissed message is cleared
                                       # immediately; this catches what nobody reviewed.

# --- offer search (M13) ------------------------------------------------------
# Leave as `simulated` unless you have deliberately opted in. The simulator is a
# complete, demonstrable feature with no external call and no possibility of a
# bill — see docs/adr/008-external-quota-and-degradation.md.
OFFER_SEARCH_PROVIDER=simulated        # simulated | serpapi
# SERPAPI_API_KEY=                     # free plan, no card. Nothing is called without it.

# Local caps, set BELOW SerpAPI's own free allowance so our stop fires first and
# theirs is a second line of defence rather than the plan. Raising these past the
# provider's free tier is how a $0 deployment acquires an invoice.
SERPAPI_MONTHLY_CAP=200
SERPAPI_DAILY_CAP=10                   # so one bad day cannot eat the month
SERPAPI_PER_USER_DAILY_CAP=2           # so one user cannot drain a shared allowance
OFFER_CACHE_TTL_HOURS=24               # a cache hit costs no quota — the largest saving there is
SUPPORT_CONTACT=the developer          # named in the "service paused" message users see

# --- personalization signals (ADR-011) ---------------------------------------
# A second, genuinely separate database holding purchase signals derived from
# bank messages, used only to personalise budgets and recommendations. No
# foreign key crosses between it and the ledger -- Postgres cannot express one,
# and that impossibility is the point.
#
# Unset means the feature does not exist: no routes, no worker task, no
# readiness entry. Not a broken one. That is the default.
#
# It must NOT be the same database as DATABASE_URL. Settings refuses to boot if
# it is, with: "the separation is the entire feature: it is what makes 'no
# cross-database foreign key' a property of the deployment rather than a
# promise in a comment."
#
# Locally, `infra/docker/init-test-db.sql` creates `frugal_signals`. In
# production this is a second Neon project.
# SIGNALS_DATABASE_URL=postgresql+asyncpg://frugal:frugal@localhost:5432/frugal_signals
# SIGNALS_DATABASE_DIRECT_URL=

# Erasure across the boundary cannot be atomic, so it is eventually consistent:
# an outbox row written with the account deletion, drained hourly. Watch
# `oldest_pending_erasure_seconds` on GET /system/providers; alert above 24h.

# --- crowdsourced price graph (ADR-013) --------------------------------------
# The bar to *publish* a receipt line into the shared graph. Above
# OCR_CONFIDENCE_THRESHOLD (0.75) on purpose: showing you your own reading is a
# lower-stakes act than telling other people what a shop charges.
PRICE_PROMOTION_CONFIDENCE_THRESHOLD=0.80
# How far line items may miss the receipt total before none of them are trusted.
# The strongest filter in the promotion rule, and it costs nothing.
PRICE_PROMOTION_TOTAL_TOLERANCE=0.05
# Distinct contributors before a store's price is shown to anyone else. A single
# observation says "exactly one person shopped here and bought this", which is a
# sentence about a person. Prefer 3 once there is enough traffic to afford it.
MIN_CONTRIBUTORS_FOR_DISPLAY=2
MIN_CONTRIBUTOR_TRUST=0.20
# Keys the contributor HMAC. Never stored in the database, so a dump alone links
# nothing. Falls back to JWT_SECRET locally; set it explicitly in production.
# **Do not rotate casually** -- rotation invalidates the one-contribution-per-day
# constraint for every existing row, which is why rows carry a pepper_version.
# CONTRIBUTION_PEPPER=

# --- points ------------------------------------------------------------------
# A cap on *awards* per day, not on points: a cap on points would make the
# cheapest contribution the most efficient way to farm.
POINTS_AWARDS_PER_USER_DAILY_CAP=60
POINTS_AWARDS_DAILY_CAP_GLOBAL=20000

# --- scraper (ADR-012) -------------------------------------------------------
# Empty, and that is the shipped configuration: a fresh deployment is incapable
# of crawling anyone, exactly as it is incapable of spending money.
#
# This can only turn *off* a host the code already knows how to read
# (app/adapters/offers/scraper/hosts.py). A host named here without an extractor
# there is inert -- the permission and the code have to move together, because
# adding one is a decision about somebody else's terms of service.
SCRAPER_ENABLED_HOSTS=
SCRAPER_REQUESTS_PER_RUN=20
SCRAPE_CACHE_TTL_HOURS=24
