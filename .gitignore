# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- node ------------------------------------------------------------------
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- ml artefacts ----------------------------------------------------------
# Model binaries are built by `make eval`/training, not committed. Versioned
# artefacts belong in S3 (M5).
*.joblib
*.pkl
models/

# --- terraform -------------------------------------------------------------
# State records every provisioned resource, including any attribute the AWS API
# returns — private IPs, ARNs, generated key material. It is not encrypted, so a
# committed state file publishes the live topology of the account.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# .terraform.lock.hcl is deliberately NOT ignored: pinning provider hashes is
# what makes an apply reproducible across machines.

# --- local data ------------------------------------------------------------
*.db
*.sqlite3
celerybeat-schedule*

# Playwright run artefacts. Traces and screenshots of a failed E2E run are
# captured against a seeded account, so they can carry real form input.
test-results/
playwright-report/

# --- os / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Database dumps and receipt images written by infra/ops/backup.sh. Its default
# destination is ./backups, so without this a routine backup puts every user's
# financial data one `git add -A` away from being committed.
backups/
*.dump
mobile/keystore/


# Built APKs are COMMITTED, deliberately.
#
# Render serves the site from this repository, so `public/downloads/*.apk` has
# to be in the tree or /download's links 404 in production. The cost is ~6 MB
# per release in history, permanently, and git never forgets -- ten releases is
# 60 MB of binaries nobody will ever diff.
#
# The alternative, when that starts to hurt: attach them to GitHub Releases
# (the Android workflow already builds and checksums them) and point the
# download page at those URLs instead. That is a change to page.tsx, not to
# this file.

# Per-machine terraform inputs (contains your current IP and public key).
infra/aws/terraform/terraform.tfvars

# Generated from `app.openapi()` by `make types` and by CI, then consumed by
# `openapi-typescript`. The *derived* file (frontend/src/lib/api/schema.d.ts)
# is committed and gated; this intermediate is not.
backend/openapi.json

# The basemap archive. Built by `scripts/build-basemap.sh`. Derived, megabytes,
# and rebuilt rather than versioned -- so it stays out of git by default.
*.pmtiles

# The one exception, and it is a deployment fact rather than a change of mind
# (ADR-014 amended). That ADR assumed the archive would be served from the API
# host, which Caddy still does at /basemap/*. There is no API host at present:
# the AWS account paused as ACCOUNT-MIGRATION.md says it would, the EC2 instance
# is gone, and Terraform holds no resources. The frontend on Render is what is
# actually running.
#
# Render serves public/ with byte ranges -- verified, 206 with a content-range
# -- which is the only thing PMTiles needs. So shipping this one file with the
# frontend is what puts a real map in production, and it is same-origin, so the
# CORS the Caddyfile carefully sets up is not even in play.
#
# 7.2 MB in history, once, for a file that changes when a city is added. When
# the API host comes back, the better home is still /opt/frugal/basemap -- at
# which point this line goes and NEXT_PUBLIC_BASEMAP_URL becomes absolute again.
!frontend/public/basemap.pmtiles
