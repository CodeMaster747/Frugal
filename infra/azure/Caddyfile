# Caddy terminates TLS in front of the API.
#
# Caddy rather than nginx because certificate issuance and renewal are built in.
# An expired certificate is one of the likelier ways a small deployment goes
# down, and it happens at 3am on a certbot cron nobody checked.
#
# {$DOMAIN} comes from the environment. With no domain configured it falls back
# to `:80`, which serves plain HTTP — fine for a first smoke test, not for
# anything holding real financial data.

{$DOMAIN} {
	encode zstd gzip

	# The frontend is on Vercel; this host serves the API only.
	handle /api/* {
		reverse_proxy api:8000 {
			health_uri /health/ready
			health_interval 30s

			# The application reads the client address for rate limiting. Without
			# these the limiter sees Caddy's address for every request and would
			# throttle all users as one.
			header_up X-Real-IP {remote_host}
		}
	}

	handle /health* {
		reverse_proxy api:8000
	}

	# Remaining allowance on the metered price provider, for the "service
	# paused" banner. Unauthenticated and carrying no user data by design: it
	# describes the deployment's own free tiers, which is the same answer for
	# everyone, and that is what lets the banner render on a signed-out page.
	#
	# Listed explicitly because the catch-all below is a deliberate 404 rather
	# than a proxy. A new unprefixed route added to the API is invisible here
	# until it appears in this file -- which is the intended default, but it
	# fails as a 404 that looks like a missing endpoint rather than a missing
	# rule.
	handle /system/* {
		reverse_proxy api:8000
	}

	# The self-hosted vector basemap (ADR-014).
	#
	# A static file, served with byte-range support -- which `file_server` does
	# natively and which the whole design depends on: the browser fetches a few
	# hundred KB of a multi-megabyte archive per session rather than the lot.
	#
	# It lives here rather than in Blob storage because ADR-010 disables shared
	# account keys and keeps every container private, and carving out a public
	# one would weaken an account-wide guarantee for a file that is a public
	# OpenStreetMap derivative anyway. Serving it from the box costs a few
	# megabytes of disk and no new credential.
	#
	# The frontend is on a different origin, so CORS is load-bearing here in the
	# same way it is for the Blob uploads: without it the archive fails at the
	# preflight and the map silently falls back to a plain background.
	handle /basemap/* {
		header {
			# Immutable in practice: a rebuilt archive gets a new filename, so a
			# long cache costs nothing and saves the range requests.
			Cache-Control "public, max-age=2592000, immutable"
			Access-Control-Allow-Origin "{$FRONTEND_ORIGIN}"
			Access-Control-Allow-Headers "range"
			Access-Control-Expose-Headers "content-range, content-length, etag"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		}
		@preflight method OPTIONS
		respond @preflight 204

		root * /opt/frugal
		file_server
	}

	# Anything else is not part of this service. A bare 404 rather than a proxy,
	# so the API is not probed through paths it does not own.
	handle {
		respond "Not found" 404
	}

	header {
		# HSTS. Two years, and preload-eligible. Only meaningful once a real
		# certificate is in place; harmless before that.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# The API returns JSON only, so nothing here is ever a document context.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

		# Do not advertise the server.
		-Server
	}

	log {
		output stdout
		format json
	}
}
