# Frontend configuration.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore public. Nothing secret belongs here.

NEXT_PUBLIC_API_URL=http://localhost:8000

# --- the basemap (ADR-014) ---------------------------------------------------
#
# Unset, the map still renders every pin -- over a coordinate grid rather than
# real geography, and it says so on screen. That is a supported state, not a
# broken one, but it is not the state you want locally: it is what "the map is
# blank" looks like.
#
# The archive is a build artefact, not a committed file (`*.pmtiles` is
# gitignored: it is a multi-megabyte derivative of an OpenStreetMap extract,
# rebuilt rather than versioned). Build one with:
#
#     brew install pmtiles          # or a release from github.com/protomaps/go-pmtiles
#     ./scripts/build-basemap.sh    # ~7 MB, ~20s, greater Chennai at z14
#     mv basemap.pmtiles frontend/public/
#
# Next serves `public/` with byte-range support, which is the whole mechanism:
# a session pulls a few hundred KB out of the archive rather than downloading
# it. Root-relative, so it resolves against whatever origin serves the app.
#
# Since the ADR-014 amendment the archive is committed, so a fresh clone already
# has one and this value works unchanged in production (render.yaml sets the
# same thing). Rebuild only to widen coverage to another city.
NEXT_PUBLIC_BASEMAP_URL=/basemap.pmtiles

# Must match the `--maxzoom` the archive was built with, or MapLibre requests
# tiles it does not contain instead of overzooming the ones it does.
NEXT_PUBLIC_BASEMAP_MAXZOOM=14
