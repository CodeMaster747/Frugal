# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the example is one of those opt-ins. The root .gitignore already
# negates this, but the nearest file wins, so a bare `.env*` here quietly
# un-tracked the one file that documents how to configure the frontend. That is
# how NEXT_PUBLIC_BASEMAP_URL came to be documented nowhere and the map came to
# render as a blank rectangle for want of one line.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
