{
  "name": "frugal-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android shell around the deployed Frugal web app",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build:standard": "cd android && ./gradlew assembleStandardRelease",
    "build:sms": "cd android && ./gradlew assembleSmsreaderRelease",
    "build:both": "cd android && ./gradlew assembleStandardRelease assembleSmsreaderRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "capacitor-sms-inbox": "^1.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
